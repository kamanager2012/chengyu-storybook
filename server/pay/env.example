# Public HTTPS origin that WeChat / Alipay can reach for async notify.
# Example: https://pay.example.com
NOTIFY_BASE_URL=

# Listen (local default)
PAY_HOST=127.0.0.1
PAY_PORT=8787

# Comma-separated browser origins allowed to call /create and /order (CORS).
# Example: http://127.0.0.1:8080,https://stories.example.com
PAY_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Local-only: allow POST /dev/simulate-paid/:orderId and skip live channel APIs.
# Never enable in production.
PAY_DEV_SIMULATE=0

# Optional path for durable order JSON (default: server/pay/.pay-data/orders.json)
# PAY_STORE_PATH=

# WeChat Pay APIv3 (Native QR)
WECHAT_APPID=
WECHAT_MCHID=
WECHAT_APIV3_KEY=
WECHAT_SERIAL_NO=
# PEM private key, use \n for newlines in one line, or a file path starting with /
WECHAT_PRIVATE_KEY=
# WeChat platform certificate PEM (for notify signature verify). File path or \n-escaped PEM.
WECHAT_PLATFORM_CERT=

# Alipay face-to-face precreate (scan QR with Alipay app)
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
# Alipay public key PEM, file path, or bare base64 (no headers)
ALIPAY_PUBLIC_KEY=
# sandbox gateway if needed; default is production
# ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# Local/debug only — never in production:
# ALIPAY_NOTIFY_TRUST_UNSIGNED=1
